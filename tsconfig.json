// The editor / typecheck project: one program over everything in the repo,
// including the parts that are never emitted (tests, examples, this config).
// Emitting is `tsconfig.build.json`, which drives the two packages through
// project references instead.
{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "composite": false,
        "noEmit": true,
        // Only the CLI's drawing surface is JSX, but this program covers it too,
        // so the setting has to be here as well as in packages/cli.
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        // packages/view/src/client runs in a browser. The emitting programs stay DOM-free.
        "lib": ["ES2024", "DOM", "DOM.Iterable"],
        "types": ["node", "react"]
    },
    "include": [
        "packages/*/src/**/*.ts",
        "packages/*/src/**/*.tsx",
        "packages/*/test/**/*.ts",
        "examples/**/*.ts",
        "vitest.config.ts"
    ]
}
