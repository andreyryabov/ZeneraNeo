{
    "name": "@zenera/rag",
    "version": "1.1.9",
    "description": "Retrieval over a corpus: openapi/swagger documents as a searchable graph, markdown and text as searchable passages.",
    "keywords": [
        "agents",
        "ai-agents",
        "llm",
        "markdown",
        "openapi",
        "rag",
        "vector-search"
    ],
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "author": "Andrey Ryabov",
    "homepage": "https://github.com/andreyryabov/ZeneraNeo#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/andreyryabov/ZeneraNeo.git",
        "directory": "packages/rag"
    },
    "bugs": "https://github.com/andreyryabov/ZeneraNeo/issues",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./command": {
            "types": "./dist/command.d.ts",
            "default": "./dist/command.js"
        },
        "./tools": {
            "types": "./dist/schema/tools.d.ts",
            "default": "./dist/schema/tools.js"
        },
        "./docs": {
            "types": "./dist/docs/index.d.ts",
            "default": "./dist/docs/index.js"
        },
        "./docs/tools": {
            "types": "./dist/docs/tools.d.ts",
            "default": "./dist/docs/tools.js"
        }
    },
    "files": [
        "dist",
        "!dist/**/*.map"
    ],
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "tsc -b",
        "clean": "tsc -b --clean && rm -rf dist",
        "prepack": "tsc -b"
    },
    "dependencies": {
        "@apidevtools/swagger-parser": "^12.0.0",
        "@lancedb/lancedb": "^0.38.0",
        "@zenera/cli": "^1.1.9",
        "@zenera/neo": "^1.1.9",
        "graphology": "^0.26.0",
        "remark-frontmatter": "^5.0.0",
        "remark-gfm": "^4.0.1",
        "remark-parse": "^11.0.0",
        "unified": "^11.0.5"
    }
}
