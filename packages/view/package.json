{
    "name": "@zenera/view",
    "version": "1.1.25",
    "description": "A live local viewer for a folder: markdown with mermaid, highlighted code, updated in place as the files change.",
    "keywords": [
        "markdown",
        "mermaid",
        "viewer",
        "live-reload",
        "syntax-highlighting"
    ],
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "author": "Andrey Ryabov",
    "homepage": "https://github.com/andreyryabov/ZeneraNeo#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/andreyryabov/ZeneraNeo.git",
        "directory": "packages/view"
    },
    "bugs": "https://github.com/andreyryabov/ZeneraNeo/issues",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "!dist/**/*.map"
    ],
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "tsc -b && node scripts/bundle.mjs",
        "bundle": "node scripts/bundle.mjs",
        "clean": "tsc -b --clean && rm -rf dist",
        "prepack": "tsc -b && node scripts/bundle.mjs"
    },
    "devDependencies": {
        "@types/react-dom": "^19.3.0",
        "esbuild": "^0.28.2",
        "hast-util-to-jsx-runtime": "^2.3.6",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "dependencies": {
        "@types/hast": "^3.0.5",
        "lowlight": "^3.3.0",
        "mermaid": "^12.2.0",
        "rehype-sanitize": "^6.0.0",
        "rehype-slug": "^6.0.0",
        "remark-gfm": "^4.0.1",
        "remark-parse": "^11.0.0",
        "remark-rehype": "^11.1.2",
        "unified": "^11.0.5"
    }
}
