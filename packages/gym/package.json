{
    "name": "@zenera/gym",
    "version": "1.1.41",
    "description": "Simulated API environments for agent training and evaluation, powered by OpenAPI and model-written generators.",
    "keywords": [
        "openapi",
        "swagger",
        "mock-server",
        "llm",
        "testing",
        "agents",
        "simulation",
        "evaluation"
    ],
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "author": "Andrey Ryabov",
    "homepage": "https://github.com/zenera-ai/ZeneraNeo#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/zenera-ai/ZeneraNeo.git",
        "directory": "packages/gym"
    },
    "bugs": "https://github.com/zenera-ai/ZeneraNeo/issues",
    "private": false,
    "type": "module",
    "exports": {
        "./command": {
            "types": "./dist/command.d.ts",
            "default": "./dist/command.js"
        }
    },
    "files": [
        "dist",
        "!dist/**/*.map"
    ],
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "tsc -b",
        "clean": "tsc -b --clean && rm -rf dist",
        "prepack": "tsc -b"
    },
    "dependencies": {
        "@apidevtools/swagger-parser": "^12.0.0",
        "@zenera/cli": "^1.1.41",
        "@zenera/neo": "^1.1.41",
        "@zenera/rag": "^1.1.41",
        "ajv": "^8.17.1",
        "ajv-formats": "^3.0.1",
        "randexp": "^0.5.3"
    }
}
