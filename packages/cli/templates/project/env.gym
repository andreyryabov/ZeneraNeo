# This project's environment when it runs against `zen gym` instead of the real
# services: the same names as .env, pointed at the mock.
#
#     zen gym serve ./assets/openapi.yaml --port 8787
#     set -a; . ./.env.gym; set +a
#     zen run
#
# What is set in the shell wins over .env, so sourcing this file first is all
# it takes to swap the real endpoints for the gym's. It is committed, so keep
# real credentials out of it: those belong in .env.

# ACME_API_TOKEN=gym
# ACME_BASE_URL=http://localhost:8787

