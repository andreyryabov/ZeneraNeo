# Sessions hold run state, blobs and whatever the agent wrote.
# None of it is source.
sessions/

# Memory is worth keeping: `graph.json`, `files/` and the vectors are what the
# agents learned. The vectors are binary, but nothing rebuilds them from the
# graph, so a clone without them recalls by term overlap until every node is
# written again. Only the lock is runtime state.
memory/.lock

# Scratch, inside the workspace so the sandbox can reach it.
.tmp/

