# The names this project's environment needs, with no values.
#
# Copy it to .env and fill it in:
#
#     cp .env.example .env
#
# .env is git-ignored and holds the real values; this file is committed, so it
# says which variables a clone has to supply without saying what they are. Add
# a name here whenever you add one to .env.

# ACME_API_TOKEN=
# ACME_BASE_URL=
