{
    "name": "@zenera/cli",
    "version": "1.1.40",
    "description": "Command-line front end for @zenera/neo: agentic projects you can run, share and commit.",
    "keywords": [
        "agents",
        "ai-agents",
        "cli",
        "llm",
        "agent-runtime",
        "tui"
    ],
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "author": "Andrey Ryabov",
    "homepage": "https://github.com/zenera-ai/ZeneraNeo#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/zenera-ai/ZeneraNeo.git",
        "directory": "packages/cli"
    },
    "bugs": "https://github.com/zenera-ai/ZeneraNeo/issues",
    "type": "module",
    "bin": {
        "zen": "./dist/main.js",
        "zn": "./dist/main.js",
        "zenera": "./dist/main.js"
    },
    "exports": {
        "./lib": {
            "types": "./dist/lib.d.ts",
            "default": "./dist/lib.js"
        }
    },
    "files": [
        "dist",
        "!dist/**/*.map",
        "postinstall.mjs",
        "templates"
    ],
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "tsc -b",
        "clean": "tsc -b --clean && rm -rf dist",
        "postinstall": "node postinstall.mjs",
        "prepack": "tsc -b"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.120.0",
        "@google/genai": "^2.30.0",
        "@inkjs/ui": "^2.0.0",
        "@openrouter/sdk": "^1.4.25",
        "@zenera/engine": "^1.1.40",
        "@zenera/neo": "^1.1.40",
        "@zenera/view": "^1.1.40",
        "google-auth-library": "^10.0.0",
        "ink": "^7.1.1",
        "openai": "^6.0.0",
        "react": "^19.2.8",
        "yaml": "^2.9.1",
        "yauzl": "^3.4.0",
        "yazl": "^3.3.1"
    },
    "devDependencies": {
        "@types/yauzl": "^3.4.0",
        "@types/yazl": "^3.3.1"
    }
}
