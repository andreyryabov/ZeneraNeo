{
    "name": "zenera-cli",
    "version": "1.0.3",
    "description": "Command-line front end for zenera-neo: agentic projects you can run, share and commit.",
    "keywords": [
        "agents",
        "ai-agents",
        "cli",
        "llm",
        "agent-runtime",
        "tui"
    ],
    "license": "MIT",
    "author": "Andrey Ryabov",
    "homepage": "https://github.com/andreyryabov/ZeneraNeo#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/andreyryabov/ZeneraNeo.git",
        "directory": "packages/cli"
    },
    "bugs": "https://github.com/andreyryabov/ZeneraNeo/issues",
    "type": "module",
    "bin": {
        "zen": "./dist/main.js",
        "zn": "./dist/main.js",
        "zenera": "./dist/main.js"
    },
    "files": [
        "dist",
        "src",
        "templates"
    ],
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "tsc -b",
        "clean": "tsc -b --clean && rm -rf dist",
        "prepack": "tsc -b"
    },
    "dependencies": {
        "@inkjs/ui": "^2.0.0",
        "ink": "^7.1.1",
        "react": "^19.2.8",
        "zenera-neo": "^1.0.3"
    },
    "peerDependencies": {
        "@anthropic-ai/sdk": "^0.120.0",
        "@google/genai": "^2.18.0",
        "@openrouter/sdk": "^1.2.80",
        "openai": "^6.0.0"
    },
    "peerDependenciesMeta": {
        "@anthropic-ai/sdk": {
            "optional": true
        },
        "@google/genai": {
            "optional": true
        },
        "@openrouter/sdk": {
            "optional": true
        },
        "openai": {
            "optional": true
        }
    }
}
