{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🧪 Run Test",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
            "args": ["run", "${file}"],
            "runtimeVersion": "24",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "name": "▶️ Run Current File",
            "type": "node",
            "request": "launch",
            "program": "${file}",
            "runtimeVersion": "24",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        }
    ]
}
