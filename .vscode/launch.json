{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Demo",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/examples/demo.ts",
      "runtimeVersion": "24",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Smoke",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/smoke.ts",
      "runtimeVersion": "24",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Current TS file",
      "type": "node",
      "request": "launch",
      "program": "${file}",
      "runtimeVersion": "24",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
