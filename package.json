{
    "name": "zenera-monorepo",
    "version": "0.0.0",
    "description": "ZeneraNeo workspace: the library and its command-line front end.",
    "license": "MIT",
    "author": "Andrey Ryabov",
    "homepage": "https://github.com/andreyryabov/ZeneraNeo#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/andreyryabov/ZeneraNeo.git"
    },
    "bugs": "https://github.com/andreyryabov/ZeneraNeo/issues",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "tsc -b tsconfig.build.json",
        "build:watch": "tsc -b tsconfig.build.json --watch",
        "clean": "tsc -b tsconfig.build.json --clean && rm -rf packages/*/dist coverage .dev .out",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "test": "node --env-file=.env ./node_modules/vitest/vitest.mjs run",
        "test:watch": "node --env-file=.env ./node_modules/vitest/vitest.mjs",
        "test:coverage": "node --env-file=.env ./node_modules/vitest/vitest.mjs run --coverage",
        "typecheck": "npm run build && tsc -p tsconfig.json --noEmit",
        "typecheck:watch": "tsc -p tsconfig.json --noEmit --watch",
        "cli": "npm run build --silent && node packages/cli/dist/main.js",
        "cli:link": "npm run build && npm link -w packages/cli",
        "cli:unlink": "npm rm -g zenera-cli",
        "check:node": "node -e \"if (+process.versions.node.split('.')[0] < 24) { console.error('Node >=24 required (running ' + process.version + '). Run: nvm use'); process.exit(1); }\"",
        "demo:simple": "bash -c '. ~/.nvm/nvm.sh && nvm exec --silent 24 node examples/demo.ts'",
        "demo:fanout": "bash -c '. ~/.nvm/nvm.sh && nvm exec --silent 24 node examples/fanout.ts'",
        "demo:triage": "bash -c '. ~/.nvm/nvm.sh && nvm exec --silent 24 node examples/triage.ts'",
        "demo:review": "bash -c '. ~/.nvm/nvm.sh && nvm exec --silent 24 node examples/review.ts'",
        "demo:inspect": "bash -c '. ~/.nvm/nvm.sh && nvm exec --silent 24 node examples/inspect.ts'",
        "demo:handbook": "bash -c '. ~/.nvm/nvm.sh && nvm exec --silent 24 node examples/handbook.ts'",
        "demo:locked": "bash -c '. ~/.nvm/nvm.sh && nvm exec --silent 24 node examples/locked.ts'",
        "demo:project": "bash -c '. ~/.nvm/nvm.sh && nvm exec --silent 24 node examples/project.ts'",
        "demo:all": "npm run demo:simple && npm run demo:fanout && npm run demo:triage && npm run demo:review && npm run demo:inspect && npm run demo:handbook && npm run demo:locked && npm run demo:project"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "@types/react": "^19.2.18",
        "@vitest/coverage-v8": "^4.1.11",
        "boxen": "^8.0.1",
        "picocolors": "^1.1.1",
        "prettier": "^3.9.6",
        "typescript": "^5.9.3",
        "vitest": "^4.1.11"
    }
}
