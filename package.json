{
  "name": "zenera-neo",
  "version": "0.1.0",
  "description": "ZeneraNeo TypeScript library.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./payload-stores": {
      "types": "./dist/payload-stores/index.d.ts",
      "default": "./dist/payload-stores/index.js"
    },
    "./memory-stores": {
      "types": "./dist/memory-stores/index.d.ts",
      "default": "./dist/memory-stores/index.js"
    },
    "./skill-providers": {
      "types": "./dist/skill-providers/index.d.ts",
      "default": "./dist/skill-providers/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage .dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check:node": "node -e \"if (+process.versions.node.split('.')[0] < 24) { console.error('Node >=24 required (running ' + process.version + '). Run: nvm use'); process.exit(1); }\"",
    "demo:simple": "npm run check:node && node examples/demo.ts",
    "demo:fanout": "npm run check:node && node examples/fanout.ts",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "openai": "5.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "boxen": "^8.0.1",
    "picocolors": "^1.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
